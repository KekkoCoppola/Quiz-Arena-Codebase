# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3000

# ── Host Panel ──────────────────────────────────────────────────────────────────
# Percorso oscurato del pannello amministrativo.
# CAMBIA questo valore in produzione prima del deploy su Raspberry Pi.
HOST_PANEL_PATH=/admin-console

# ── Autenticazione JWT ───────────────────────────────────────────────────────────
# Stringa lunga e casuale usata per firmare i token JWT degli host.
# Genera un valore sicuro con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NON committare mai il valore reale. Questo file (.env.example) è solo un template.
JWT_SECRET=CAMBIA_QUESTO_VALORE_CON_UNA_STRINGA_LUNGA_E_CASUALE

# Durata del token JWT prima che scada (es. 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# ── Database ─────────────────────────────────────────────────────────────────────
# Percorso del file SQLite (relativo alla root del progetto).
# Il file viene creato automaticamente al primo avvio da quiz-manager.js (Step 2).
DB_PATH=./server/db/database.sqlite

# ── Ambiente ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
